# ============================================================================
# Healthcare AI Model Orchestration Platform - Environment Configuration
# ============================================================================

# Public Client Configuration (Safe for browser)
NEXT_PUBLIC_APP_NAME="CareOrchestrate AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-Only Secrets (Never leak to client bundles)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# AI Model Providers (Free-tier compatible)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Get a free key at: https://console.groq.com/
GROQ_API_KEY=""

# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# Translation & Speech Services
TRANSLATION_API_URL="https://libretranslate.de"
WHISPER_API_URL=""

# Execution & Demonstration Controls
# Active default provider: gemini | groq | huggingface | mock
MODEL_PROVIDER="gemini"

# When true, the entire system operates seamlessly in deterministic offline demo mode
# if external API keys or Supabase connections are missing. Perfect for hackathon evaluation!
DEMO_MODE="true"

# Default localization language: en | hi | mr
DEFAULT_LANGUAGE="en"
